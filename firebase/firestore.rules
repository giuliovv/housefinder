rules_version = '2';

// House Finder shared lists. A board is just a collection of "items" under a long random id
// (the id in the share link is the only key). There is no board document and no way to list
// boards, so you can only reach a board if you were given its link.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{boardId}/items/{itemKey} {
      function validBoard() { return boardId.size() >= 30 && boardId.size() <= 64; }
      function validItem() {
        let d = request.resource.data;
        return d.keys().hasOnly(['key', 'snap', 'savers'])
          && d.key is string && d.key.size() <= 200
          && d.snap is map && d.snap.keys().hasOnly(['address', 'price', 'thumb', 'url'])
          && d.savers is map && d.savers.size() <= 20;
      }

      allow get, list: if validBoard();
      allow create, update: if validBoard() && validItem();
      allow delete: if validBoard();
    }
    // everything else stays closed
    match /{document=**} { allow read, write: if false; }
  }
}
