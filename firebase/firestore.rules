rules_version = '2';

// House Finder shared lists. A board is just a collection of "items" under a long random id
// (the id in the share link is the only key). There is no board document and no way to list
// boards, so you can only reach a board if you were given its link.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{boardId}/items/{itemKey} {
      function validBoard() { return boardId.size() >= 30 && boardId.size() <= 64; }
      function validItem() {
        let d = request.resource.data;
        return d.keys().hasOnly(['key', 'snap', 'savers'])
          && d.key is string && d.key.size() <= 200
          && d.snap is map && d.snap.keys().hasOnly(['address', 'price', 'thumb', 'url'])
          && d.savers is map && d.savers.size() <= 20;
      }

      allow get, list: if validBoard();
      allow create, update: if validBoard() && validItem();
      allow delete: if validBoard();
    }
    // Anonymous usage counters (frontend/src/lib/stats.ts): one document per day holding plain numbers.
    // Clients can only add to a fixed list of counters; nobody can read them (the report script uses the admin key).
    match /stats/{day} {
      allow read: if false;
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visitors', 'visitors_new', 'visitors_mobile', 'm_first_swipe', 'm_swipes_10', 'm_swipes_25', 'm_swipes_50', 'm_ready_shown', 'm_ready_go', 'm_browse_opened', 'm_browse_deep', 'm_filter_used', 'm_map_used', 'm_area_drawn', 'm_q_answered', 'm_q_skipped', 'm_saved', 'm_share_created', 'm_share_joined', 'm_agency_click', 'ev_match_shown', 'ev_match_hit', 'ev_match_miss', 'ev_match_opened']);
      allow delete: if false;
    }
    // everything else stays closed
    match /{document=**} { allow read, write: if false; }
  }
}
