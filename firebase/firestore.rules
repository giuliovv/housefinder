rules_version = '2';

// Legacy boards have only a share link. New v2 boards also have server-managed metadata;
// the client cannot read the owner hash or re-create items after deletion.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{boardId} {
      allow read, write: if false;
    }
    match /boards/{boardId}/items/{itemKey} {
      function validBoard() { return boardId.size() >= 30 && boardId.size() <= 64; }
      function activeBoard() {
        return !boardId.matches('^v2_.*') ||
          (exists(/databases/$(database)/documents/boards/$(boardId)) &&
           get(/databases/$(database)/documents/boards/$(boardId)).data.active == true);
      }
      function validItem() {
        let d = request.resource.data;
        return d.keys().hasOnly(['key', 'snap', 'savers'])
          && d.key is string && d.key.size() <= 200
          && d.snap is map && d.snap.keys().hasOnly(['address', 'price', 'thumb', 'url'])
          && d.savers is map && d.savers.size() <= 20;
      }

      allow get, list: if validBoard() && activeBoard();
      allow create, update: if validBoard() && activeBoard() && validItem();
      allow delete: if validBoard() && activeBoard();
    }
    // Anonymous usage counters (frontend/src/lib/stats.ts): one document per day holding plain numbers.
    // Clients can only add to a fixed list of counters; nobody can read them (the report script uses the admin key).
    match /stats/{day} {
      allow read: if false;
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visitors', 'visitors_new', 'visitors_mobile', 'm_stayed_5s', 'm_touched', 'm_first_swipe', 'm_swipes_10', 'm_swipes_25', 'm_swipes_50', 'm_ready_shown', 'm_ready_go', 'm_browse_opened', 'm_browse_deep', 'm_filter_used', 'm_map_used', 'm_area_drawn', 'm_q_answered', 'm_q_skipped', 'm_saved', 'm_share_created', 'm_share_joined', 'm_agency_click', 'ev_match_shown', 'ev_match_hit', 'ev_match_miss', 'ev_match_opened', 'ab_w_on_new', 'ab_w_on_start', 'ab_w_on_swipe', 'ab_w_on_swipe10', 'ab_w_on_browse', 'ab_w_off_new', 'ab_w_off_swipe', 'ab_w_off_swipe10', 'ab_w_off_browse', 'ab_w_on_touch', 'ab_w_off_touch']);
      allow delete: if false;
    }
    // The same counters split by where the visit came from (`<day>~<source>~<campaign>`, e.g. 2026-11-03~tiktok~demo1): the source must be
    // one of a fixed list so nobody can fill the collection with made-up names; the campaign is a short tag.
    match /src_stats/{id} {
      allow read: if false;
      allow create, update: if id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}~[a-z0-9_-]{1,24}~[a-z0-9_-]{0,24}$')
        && id.split('~')[1] in ['tiktok', 'instagram', 'facebook', 'youtube', 'reddit', 'x', 'twitter', 'linkedin', 'whatsapp', 'telegram', 'newsletter', 'email', 'google', 'bing', 'friends', 'ad', 'ads', 'test', 'demo']
        && request.resource.data.keys().hasOnly(['visitors', 'visitors_new', 'visitors_mobile', 'm_stayed_5s', 'm_touched', 'm_first_swipe', 'm_swipes_10', 'm_swipes_25', 'm_swipes_50', 'm_ready_shown', 'm_ready_go', 'm_browse_opened', 'm_browse_deep', 'm_filter_used', 'm_map_used', 'm_area_drawn', 'm_q_answered', 'm_q_skipped', 'm_saved', 'm_share_created', 'm_share_joined', 'm_agency_click', 'ev_match_shown', 'ev_match_hit', 'ev_match_miss', 'ev_match_opened', 'ab_w_on_new', 'ab_w_on_start', 'ab_w_on_swipe', 'ab_w_on_swipe10', 'ab_w_on_browse', 'ab_w_off_new', 'ab_w_off_swipe', 'ab_w_off_swipe10', 'ab_w_off_browse', 'ab_w_on_touch', 'ab_w_off_touch']);
      allow delete: if false;
    }
    // everything else stays closed
    match /{document=**} { allow read, write: if false; }
  }
}
